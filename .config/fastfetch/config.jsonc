{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/navi.txt",
	"type": "file",
        "color": {
            "1": "32",
        }
    },
    "display": {
          "separator": " "
    },
    "modules": [
         {
            "type": "os",
            "key": "OS   ",
            "keyColor": "35",  // = color1
        },
        {
            "type": "kernel",
            "key": " ├  ",
            "keyColor": "35",
        },
        {
            "type": "packages",
            "key": " ├ 󰏖 ",
            "keyColor": "35",
        },
        {
            "type": "shell",
            "key": " ├  ",
            "keyColor": "35",
        },
        {
            "type": "wm",
            "key": " ├ 󰀻 ",
            "keyColor": "35",
        },
        {
            "type": "terminal",
            "key": " └  ",
            "keyColor": "35",
        },
        "break",
        {
            "type": "users",
            "key": "HOST ",
            "format": "{1}",
            "keyColor": "35",
        },
        {
            "type": "cpu",
            "format": "{1} @ {7}",
            "key": " ├  ",
            "keyColor": "35",
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ├ 󰢮 ",
            "keyColor": "35",
        },
        {
            "type": "memory",
            "key": " ├  ",
            "keyColor": "35",
        },
        {
            "type": "swap",
            "key": " ├ 󰓡 ",
            "keyColor": "35",
        },
        {
            "type": "disk",
	    "format": "{1} / {2} ({3})",
            "key": " ├ 󰋊 ",
            "keyColor": "35",
        },
        {
            "type": "monitor",
            "key": " └  ",
            "keyColor": "35",
	    "format": "{width}x{height} @ {refresh-rate} Hz - {inch}\""
        },
        "break",
        {
            "type": "colors",
            "symbol": "#",
        },
        "break",
        "break",
    ]
}
