! X colors.
! Generated by 'wal'
*foreground:        #dcbfbd
*background:        #010000
*.foreground:       #dcbfbd
*.background:       #010000
emacs*foreground:   #dcbfbd
emacs*background:   #010000
URxvt*foreground:   #dcbfbd
XTerm*foreground:   #dcbfbd
UXTerm*foreground:  #dcbfbd
URxvt*background:   [100]#010000
XTerm*background:   #010000
UXTerm*background:  #010000
URxvt*cursorColor:  #dcbfbd
XTerm*cursorColor:  #dcbfbd
UXTerm*cursorColor: #dcbfbd
URxvt*borderColor:  [100]#010000

! Colors 0-15.
*.color0: #010000
*color0:  #010000
*.color1: #9D586A
*color1:  #9D586A
*.color2: #938771
*color2:  #938771
*.color3: #BE6C80
*color3:  #BE6C80
*.color4: #CE768B
*color4:  #CE768B
*.color5: #E17E97
*color5:  #E17E97
*.color6: #BFAD8C
*color6:  #BFAD8C
*.color7: #dcbfbd
*color7:  #dcbfbd
*.color8: #9a8584
*color8:  #9a8584
*.color9: #9D586A
*color9:  #9D586A
*.color10: #938771
*color10:  #938771
*.color11: #BE6C80
*color11:  #BE6C80
*.color12: #CE768B
*color12:  #CE768B
*.color13: #E17E97
*color13:  #E17E97
*.color14: #BFAD8C
*color14:  #BFAD8C
*.color15: #dcbfbd
*color15:  #dcbfbd

! Black color that will not be affected by bold highlighting.
*.color66: #010000
*color66:  #010000

! Xclock colors.
XClock*foreground: #dcbfbd
XClock*background: #010000
XClock*majorColor:  rgba:dc/bf/bd/ff
XClock*minorColor:  rgba:dc/bf/bd/ff
XClock*hourColor:   rgba:dc/bf/bd/ff
XClock*minuteColor: rgba:dc/bf/bd/ff
XClock*secondColor: rgba:dc/bf/bd/ff

! Set depth to make transparency work.
URxvt*depth: 32
